<!DOCTYPE html>
<html dir="rtl" lang="he">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { font-family: Arial, "Segoe UI", sans-serif; direction: rtl; text-align: right; color: #1f2933; line-height: 1.6; font-size: 15px; }
      .wrap { max-width: 640px; margin: 0 auto; padding: 8px 16px; }
      h1, h2, h3 { color: #234e52; line-height: 1.3; }
      h1 { font-size: 20px; } h2 { font-size: 17px; } h3 { font-size: 15px; }
      .box { background: #f4f7f6; border-radius: 8px; padding: 12px 16px; margin: 12px 0; }
      .muted { color: #6b7280; font-size: 13px; }
      ul, ol { padding-right: 20px; padding-left: 0; margin-right: 0; }
      p, h1, h2, h3, li, div, td { direction: rtl; text-align: right; }
    </style>
  </head>
  <body dir="rtl" style="direction:rtl;text-align:right;margin:0">
    <div class="wrap" dir="rtl" style="direction:rtl;text-align:right;font-family:Arial,sans-serif;max-width:640px;margin:0 auto;padding:8px 16px">
      <%= yield %>
    </div>
  </body>
</html>
